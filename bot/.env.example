# Copy this file to .env for local testing (never commit .env)
# In GitHub Actions this is set as a repository secret named DISCORD_WEBHOOK_URL
DISCORD_WEBHOOK_URL=YOUR_WEBHOOK_URL_HERE

# Optional: Discord role id for the @Sniper role so crash alerts actually ping it.
# Enable Developer Mode in Discord, right-click the role → Copy Role ID.
# If left empty, the bot just prints a plain "@Sniper" text (no real ping).
SNIPER_ROLE_ID=
